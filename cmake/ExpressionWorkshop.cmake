# Dataset authoring is independent of the ML training worker and main role state.
add_library(HibernationExpressionWorkshop STATIC plugins/style-lora/DatasetWorkshop.cpp)
target_include_directories(HibernationExpressionWorkshop PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/plugins/style-lora")
target_compile_definitions(HibernationExpressionWorkshop PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(HibernationExpressionWorkshop PUBLIC AYInference AYCrypto AYIO nlohmann_json::nlohmann_json crypt32)
if(TARGET Hibernation_StyleLora)
    target_link_libraries(Hibernation_StyleLora PRIVATE HibernationExpressionWorkshop)
endif()
if(BUILD_TESTING)
    add_executable(Hibernation_ExpressionWorkshopTests tests/ExpressionWorkshop.cpp)
    target_compile_definitions(Hibernation_ExpressionWorkshopTests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(Hibernation_ExpressionWorkshopTests PRIVATE HibernationExpressionWorkshop)
    add_test(NAME Hibernation_ExpressionWorkshop COMMAND Hibernation_ExpressionWorkshopTests "${CMAKE_BINARY_DIR}/expression-workshop-tests")
    set_tests_properties(Hibernation_ExpressionWorkshop PROPERTIES TIMEOUT 60)
    if(TARGET Hibernation_Checks)
        add_dependencies(Hibernation_Checks Hibernation_ExpressionWorkshopTests)
    endif()
endif()

