target_sources(HibernationCore PRIVATE src/DesktopIntegration.cpp src/NativeLoginWindow.cpp src/NapcatProcess.cpp)
target_link_libraries(HibernationCore PRIVATE advapi32 shell32)
target_sources(HibernationCore PRIVATE src/EngineComponentInstaller.cpp)
target_link_libraries(HibernationCore PRIVATE AYApplicationInstaller)
add_executable(Hibernation_Installer tools/EngineInstaller.cpp)
target_link_libraries(Hibernation_Installer PRIVATE AYApplicationInstaller nlohmann_json::nlohmann_json)
set_target_properties(Hibernation_Installer PROPERTIES OUTPUT_NAME hibernation-installer)
add_dependencies(hibernation-agent Hibernation_Installer)
add_executable(Hibernation_GuiInstaller WIN32 tools/XiaoAiLauncher.cpp)
set_target_properties(Hibernation_GuiInstaller PROPERTIES OUTPUT_NAME XiaoAi-Installer)
target_compile_definitions(Hibernation_GuiInstaller PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
target_link_libraries(Hibernation_GuiInstaller PRIVATE AYApplicationInstaller AYCrypto nlohmann_json::nlohmann_json httplib::httplib comctl32 shell32 ole32 gdiplus)
add_executable(Hibernation_NapcatHost WIN32 src/NapcatHostMain.cpp src/NapcatProcess.cpp)
set_target_properties(Hibernation_NapcatHost PROPERTIES OUTPUT_NAME hibernation-napcat-host)
target_include_directories(Hibernation_NapcatHost PRIVATE include)
target_compile_definitions(Hibernation_NapcatHost PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(Hibernation_NapcatHost PRIVATE AYPlatform AYCrypto nlohmann_json::nlohmann_json advapi32 shell32)
# AYCrypto's sodium import is a raw library in the current SDK, so CMake's
# TARGET_RUNTIME_DLLS does not discover it. Keep this host closure explicit.
find_file(HA_NAPCAT_SODIUM_DLL NAMES libsodium.dll HINTS "${VCPKG_INSTALLED_DIR}/x64-windows/bin" "${CMAKE_BINARY_DIR}" REQUIRED)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/napcat-host-runtime-$<CONFIG>.txt" CONTENT "$<TARGET_FILE:Hibernation_NapcatHost>\n$<JOIN:$<TARGET_RUNTIME_DLLS:Hibernation_NapcatHost>,\n>\n${HA_NAPCAT_SODIUM_DLL}\n")
add_custom_target(Hibernation_NapcatHostRuntime
    COMMAND "${CMAKE_COMMAND}" "-DINPUT=${CMAKE_BINARY_DIR}/napcat-host-runtime-$<CONFIG>.txt" "-DDESTINATION=${CMAKE_BINARY_DIR}/components/napcat-host" -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/StageNapcatHost.cmake"
    DEPENDS Hibernation_NapcatHost)
add_dependencies(hibernation-agent Hibernation_NapcatHostRuntime)
if(MSVC)
    set_target_properties(hibernation-agent PROPERTIES WIN32_EXECUTABLE TRUE)
    target_link_options(hibernation-agent PRIVATE /ENTRY:wmainCRTStartup)
endif()
if(BUILD_TESTING AND WIN32)
    find_package(httplib CONFIG REQUIRED)
    add_executable(Hibernation_DesktopIntegrationFixture tests/DesktopIntegrationFixture.cpp)
    target_compile_definitions(Hibernation_DesktopIntegrationFixture PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(Hibernation_DesktopIntegrationFixture PRIVATE httplib::httplib nlohmann_json::nlohmann_json)
    add_executable(Hibernation_DesktopIntegrationTests tests/DesktopIntegrationTests.cpp src/DesktopIntegration.cpp src/NapcatProcess.cpp)
    target_include_directories(Hibernation_DesktopIntegrationTests PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
    target_compile_definitions(Hibernation_DesktopIntegrationTests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(Hibernation_DesktopIntegrationTests PRIVATE AYPlatform AYNetworkHttp AYCrypto nlohmann_json::nlohmann_json httplib::httplib advapi32 shell32)
    add_dependencies(Hibernation_DesktopIntegrationTests Hibernation_DesktopIntegrationFixture Hibernation_NapcatHostRuntime)
    add_test(NAME Hibernation_DesktopIntegration COMMAND Hibernation_DesktopIntegrationTests "$<TARGET_FILE:Hibernation_DesktopIntegrationFixture>" "${CMAKE_BINARY_DIR}/desktop-integration-tests")
    set_tests_properties(Hibernation_DesktopIntegration PROPERTIES TIMEOUT 100)
    if(TARGET Hibernation_Checks)
        add_dependencies(Hibernation_Checks Hibernation_DesktopIntegrationTests)
    endif()
endif()
