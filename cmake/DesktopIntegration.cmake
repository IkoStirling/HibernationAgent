    set_tests_properties(Hibernation_RestartNapcat PROPERTIES TIMEOUT 100)
    add_test(NAME Hibernation_DesktopQuickStart COMMAND "${HA_PWSH}" -NoProfile -File "${CMAKE_CURRENT_SOURCE_DIR}/tests/DesktopQuickStart.ps1" -ProjectRoot "${CMAKE_CURRENT_SOURCE_DIR}" -BuildRoot "${CMAKE_BINARY_DIR}")
    set_tests_properties(Hibernation_DesktopQuickStart PROPERTIES TIMEOUT 90)
