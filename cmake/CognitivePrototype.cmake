# Application-owned experiment: never enabled in normal builds or production startup.
option(HA_BUILD_COGNITIVE_PROTOTYPE "Build the isolated synthetic cognitive loop experiment" OFF)
if(HA_BUILD_COGNITIVE_PROTOTYPE)
    add_library(HibernationCognitiveLoop STATIC EXCLUDE_FROM_ALL src/CognitiveLoop.cpp src/CognitiveModel.cpp)
    target_link_libraries(HibernationCognitiveLoop PUBLIC HibernationCore)
    add_executable(Hibernation_CognitivePrototype EXCLUDE_FROM_ALL tools/CognitivePrototype.cpp)
    target_link_libraries(Hibernation_CognitivePrototype PRIVATE HibernationCognitiveLoop)
    target_compile_definitions(Hibernation_CognitivePrototype PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    set_target_properties(Hibernation_CognitivePrototype PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/experiments/cognitive")
    add_custom_command(TARGET Hibernation_CognitivePrototype POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_RUNTIME_DLLS:Hibernation_CognitivePrototype>
        "$<TARGET_FILE_DIR:Hibernation_CognitivePrototype>" COMMAND_EXPAND_LISTS)
    if(MSVC)
        target_compile_options(HibernationCognitiveLoop PRIVATE /utf-8 /W4)
    endif()
    if(BUILD_TESTING)
        add_executable(Hibernation_CognitiveLoopTests EXCLUDE_FROM_ALL tests/CognitiveLoop.cpp)
        target_link_libraries(Hibernation_CognitiveLoopTests PRIVATE HibernationCognitiveLoop AYTest)
        set_target_properties(Hibernation_CognitiveLoopTests PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/experiments/cognitive")
        add_test(NAME Hibernation_CognitiveLoop COMMAND Hibernation_CognitiveLoopTests)
        if(TARGET Hibernation_Checks)
            add_dependencies(Hibernation_Checks Hibernation_CognitiveLoopTests Hibernation_CognitivePrototype)
        endif()
        find_program(HA_COGNITIVE_PYTHON NAMES python python3 HINTS "${HA_DEPENDENCY_ROOT}/style-lora-venv/Scripts")
        if(HA_COGNITIVE_PYTHON)
            add_test(NAME Hibernation_CognitivePrototypeProcess COMMAND "${HA_COGNITIVE_PYTHON}"
                "${CMAKE_CURRENT_SOURCE_DIR}/tests/CognitivePrototype.py" "$<TARGET_FILE:Hibernation_CognitivePrototype>"
                "${CMAKE_BINARY_DIR}/experiments/cognitive/process-tests")
            set_tests_properties(Hibernation_CognitivePrototypeProcess PROPERTIES TIMEOUT 60)
        endif()
        set_tests_properties(Hibernation_CognitiveLoop PROPERTIES TIMEOUT 30)
        if(HA_PWSH)
            add_test(NAME Hibernation_CognitiveModelFixture COMMAND "${HA_PWSH}" -NoProfile -File "${CMAKE_CURRENT_SOURCE_DIR}/scripts/RunCognitiveModelLab.ps1" -BuildRoot "${CMAKE_BINARY_DIR}" -OutputRoot "${CMAKE_BINARY_DIR}/experiments/cognitive/model-fixtures")
            add_test(NAME Hibernation_BuildPaths COMMAND "${HA_PWSH}" -NoProfile -File "${CMAKE_CURRENT_SOURCE_DIR}/tests/BuildPaths.ps1" -ProjectRoot "${CMAKE_CURRENT_SOURCE_DIR}")
            add_test(NAME Hibernation_CognitiveModelContinuityFixture COMMAND "${HA_PWSH}" -NoProfile -File "${CMAKE_CURRENT_SOURCE_DIR}/scripts/RunCognitiveModelLab.ps1" -BuildRoot "${CMAKE_BINARY_DIR}" -OutputRoot "${CMAKE_BINARY_DIR}/experiments/cognitive/model-fixtures" -Variant continuity -MaxCalls 9)
            add_test(NAME Hibernation_CognitiveBudgetFixture COMMAND "${HA_PWSH}" -NoProfile -File "${CMAKE_CURRENT_SOURCE_DIR}/tests/CognitiveBudget.ps1" -ProjectRoot "${CMAKE_CURRENT_SOURCE_DIR}" -BuildRoot "${CMAKE_BINARY_DIR}")
            set_tests_properties(Hibernation_CognitiveModelFixture PROPERTIES TIMEOUT 90)
            set_tests_properties(Hibernation_BuildPaths PROPERTIES TIMEOUT 30)
            set_tests_properties(Hibernation_CognitiveModelContinuityFixture PROPERTIES TIMEOUT 90)
            set_tests_properties(Hibernation_CognitiveBudgetFixture PROPERTIES TIMEOUT 90)
        endif()
    endif()
endif()
