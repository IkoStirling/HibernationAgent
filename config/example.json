{
  "schemaVersion": 1,
  "frontend": {
    "startupAnimation": true,
    "reducedMotion": false
  },
  "dataRoot": "../data",
  "characterRoot": "../character",
  "uiRoot": "../ui",
  "port": 0,
  "credentialEnvironment": "HIBERNATION_SESSION_KEY",
  "contextBytes": 24000,
  "contextControl": {
    "enabled": true,
    "preset": "balanced"
  },
  "recentMessageCount": 12,
  "maxMemoriesInContext": 16,
  "solitudeIntervalMs": 900000,
  "idleBeforeSolitudeMs": 120000,
  "reflectOnActivities": false,
  "maxStartsPerHour": 600,
  "profiles": [
    {
      "id": "mock",
      "label": "离线模拟 · 无需 API",
      "protocol": "mock",
      "enabled": true,
      "timeoutMs": 20000,
      "maxOutputTokens": 2048
    },
    {
      "id": "local",
      "label": "本机模型（配置后启用）",
      "protocol": "chat-completions",
      "enabled": false,
      "origin": "http://127.0.0.1:11434",
      "basePath": "/v1",
      "model": "replace-with-installed-model",
      "credentialEnvironment": "",
      "supportsJsonSchema": false,
      "legacyMaxTokens": true,
      "timeoutMs": 30000,
      "maxOutputTokens": 2048
    },
    {
      "id": "remote",
      "label": "远程兼容模型（配置后启用）",
      "protocol": "chat-completions",
      "enabled": false,
      "origin": "https://replace-with-your-provider.invalid",
      "basePath": "/v1",
      "model": "replace-with-model-name",
      "credentialEnvironment": "HIBERNATION_MODEL_KEY",
      "supportsJsonSchema": false,
      "timeoutMs": 30000,
      "maxOutputTokens": 2048
    }
  ],
  "maxToolRounds": 6,
  "plugins": {
    "mentor": {"enabled":true,"allowExecution":true,"backend":"chatgpt","codexExecutable":"","model":"","useSystemProxy":true,"proxyOrigin":"","maxRequestsPerHour":12,"cooldownSeconds":60,"timeoutSeconds":35},
    "pocket": {"enabled":false,"scrambleSteps":4,"maximumMoves":24},
    "atelier": {
      "enabled": false,
      "maximumPieces": 48
    },
    "habitat": {
      "enabled": false,
      "autoSpawn": true,
      "autoInteract": true,
      "maxObjects": 3,
      "spawnSeconds": 120,
      "lifetimeMinSeconds": 300,
      "lifetimeMaxSeconds": 600,
      "creationsPerMinute": 12,
      "interactionProbability": 0.35,
      "wakeOnAction": false,
      "reducedMotion": false
    },
    "reading": {"enabled": false,"language": "zh","maxRequestsPerHour": 60,"useSystemProxy": true,"autonomousReading": false},
    "television": {
      "enabled": false,
      "volume": 65,
      "topmost": true
    },
    "tts": {
      "maxSeconds": 60,
      "rate": 5,
      "enabled": false,
      "autoSpeak": true,
      "backend": "system",
      "respectModelSpeech": false
    },
    "weather": {
      "enabled": false,
      "refreshMinutes": 30,
      "city": ""
    },
    "deepseek-pricing": {
      "enabled": false,
      "mode": "auto",
      "peakMaxToolRounds": 3,
      "peakMaxRewrites": 1,
      "deferPrefetch": true,
      "refreshMinutes": 360,
      "maxAgeHours": 48,
      "useSystemProxy": false
    },
    "rhythm": {
      "enabled": false,
      "automaticRest": true,
      "idleBeforeRestSeconds": 300,
      "restSeconds": 180,
      "automaticProbability": 0.3
    },
    "widget": {
      "enabled": false,
      "skin": "dinosaur",
      "animationMode": "sequence",
      "animationPack": "",
      "animationCacheMiB": 64,
      "palette": "forest",
      "reducedMotion": false,
      "size": 112,
      "roam": true,
      "showBubble": true,
      "bubbleMaxCharacters": 72,
      "charactersPerSecond": 24,
      "pageHoldSeconds": 1.2,
      "respectModelBubble": false,
      "reactionCacheEnabled": false,
      "reactionCooldownMs": 8000,
      "reactionProbability": 0.45,
      "autonomousMode": false,
      "autonomyIdleSeconds": 30
    }
  },
  "computer": {
    "enabled": true,
    "allowScreenCapture": false,
    "readRoots": []
  },
  "remoteStorage": {
    "enabled": false,
    "url": "",
    "kind": "none"
  },
  "review": {
    "enabled": false,
    "retainConversationFocus": false,
    "profileId": "",
    "maxRewrites": 2
  }
}
