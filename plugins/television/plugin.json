{
  "id": "television",
  "name": "浮动电视",
  "description": "网页以缩放导航与视频满屏呈现；角色用过滤HTML浏览，视频内容由视频插件读取实际帧。",
  "version": "0.5.0",
  "api_version": 2,
  "library": "Hibernation_Television.dll",
  "capabilities": [
    "desktop.media-window",
    "media.decode",
    "media.frame-observation",
    "media.sequence-observation",
    "network.video-search"
  ],
  "settings_ui": [
    {
      "key": "frameStyle",
      "type": "select",
      "label": "电视外观",
      "default": "television",
      "options": [
        [
          "television",
          "小电视边框"
        ],
        [
          "window",
          "普通窗口"
        ]
      ]
    },
    {
      "key": "framePalette",
      "type": "select",
      "label": "电视配色",
      "default": "sage",
      "options": [
        [
          "sage",
          "苔绿"
        ],
        [
          "walnut",
          "胡桃木"
        ],
        [
          "ivory",
          "暖白"
        ]
      ]
    },
    {
      "key": "browserUseSystemProxy",
      "label": "网页窗口跟随系统代理（重启生效，默认直连）",
      "type": "toggle",
      "default": false
    },
    {
      "key": "pageLayoutWidth",
      "label": "导航网页布局宽度（像素）",
      "type": "number",
      "default": 1280,
      "min": 960,
      "max": 1920,
      "step": 80
    }
  ]
}
