// Synthetic OneBot loopback only: no real QQ or external model endpoint.
void multiReplyLedgerTests(const std::filesystem::path& root){
    const auto s=settings({{"selfUserId","10001"},{"ownerUserId","20001"},{"mergeWindowMs",0}});
    const auto input=*parseEvent(event("20001","9101","fixture"),s,nowMs());const std::string id=input.at("id");
    const Json messages=Json::array({"一。","二。","三。"});
    {Ledger ledger(root/"admission");ledger.enqueue(input,8);check(!ledger.prepareReply(id,messages,[]{return false;}),"pause raced with model completion prevents publishing reply bundle");const auto pending=ledger.next();check(pending&&!pending->contains("reply_messages"),"rejected preparation leaves pending input untouched");}
    {Ledger ledger(root/"restart");check(ledger.enqueue(input,8)=="queued","bundle row enqueued");check(ledger.prepareReply(id,messages),"bundle prepared atomically");const auto sending=ledger.beginDelivery(id);check(sending&&sending->at("delivery_in_flight")==0,"first part reserved before HTTP");check(!ledger.acknowledgeDelivery(id,1,{{"message_id",999}}),"out of order receipt rejected");check(!ledger.acknowledgeDelivery(id,0,{{"message_id",1}}),"first receipt not whole bundle completion");check(!ledger.acknowledgeDelivery(id,0,{{"message_id",1}}),"duplicate receipt rejected");}
    {Ledger ledger(root/"restart");const auto next=ledger.next();if(!(next&&next->at("delivery_cursor")==1&&next->at("delivery_receipts").size()==1)){std::cerr<<"multireply restart diagnostic "<<Json{{"next",next?*next:Json(nullptr)},{"status",ledger.status()}}.dump()<<'\n';for(const auto& record:rows(root/"restart","napcat"))std::cerr<<"multireply synthetic ledger "<<record.payload<<'\n';}check(next&&next->at("delivery_cursor")==1&&next->at("delivery_receipts").size()==1,"restart preserves cursor and confirmed receipt");check(!ledger.prepareReply(id,Json::array({"replacement"})),"prepared bundle cannot be replaced");const auto sending=ledger.beginDelivery(id);check(sending&&sending->at("delivery_in_flight")==1,"restart begins second part without resending first");}
    {Ledger ledger(root/"restart");check(!ledger.next()&&ledger.status().at("unknown")==1,"crash in second HTTP send retires uncertain bundle");}
    {Ledger ledger(root/"complete");ledger.enqueue(input,8);ledger.prepareReply(id,messages);for(std::size_t n=0;n<3;++n){check(ledger.beginDelivery(id)->at("delivery_cursor")==n,"parts begin in order");check(ledger.acknowledgeDelivery(id,n,{{"message_id",n+1}})==(n==2),"only last receipt completes bundle");}check(ledger.status().at("sent")==1&&!ledger.next(),"one bundle completion, not three inputs");}
    {Ledger ledger(root/"rejection");ledger.enqueue(input,8);ledger.prepareReply(id,messages);ledger.beginDelivery(id);ledger.acknowledgeDelivery(id,0,{{"message_id",1}});for(int n=0;n<3;++n){ledger.update(id,{{"next_ms",0}});check(ledger.beginDelivery(id)->at("delivery_cursor")==1,"definite rejection retries only current part");check(ledger.rejectDelivery(id,1,true)==(n<2),"bounded definite rejection attempts");}check(!ledger.next()&&ledger.status().at("failed")==1,"partial rejection is failed, not sent");}
    {Ledger ledger(root/"paused");ledger.enqueue(input,8);ledger.prepareReply(id,messages);ledger.beginDelivery(id);ledger.discardPreparedReplies("manual_pause");check(!ledger.acknowledgeDelivery(id,0,{{"message_id",1}}),"late success cannot resurrect manually retired tail");check(!ledger.next(),"pause tail never resumes");bool retained=false;for(const auto& item:rows(root/"paused","napcat")){const auto row=Json::parse(item.payload);if(row.value("id",std::string{})==id)retained=row.at("status")=="unknown"&&row.at("delivery_cursor")==1&&row.at("delivery_receipts").size()==1;}check(retained,"late real success retained despite cancellation");}
    {Ledger ledger(root/"offline");ledger.enqueue(input,8);ledger.prepareReply(id,messages);ledger.beginDelivery(id);ledger.acknowledgeDelivery(id,0,{{"message_id",1}});ledger.discardOffline("manual");check(!ledger.beginDelivery(id)&&!ledger.next(),"offline clears remaining prepared parts");}
    {Ledger ledger(root/"offline-in-flight");ledger.enqueue(input,8);ledger.prepareReply(id,messages);ledger.beginDelivery(id);ledger.discardOffline("manual");check(ledger.status().at("unknown")==1,"offline counts uncertain in-flight delivery");check(!ledger.acknowledgeDelivery(id,0,{{"message_id",1}}),"offline late receipt cannot revive remaining parts");ledger.discardOffline("manual");check(ledger.status().at("unknown")==1&&!ledger.next(),"repeated offline does not double count uncertain delivery");}
    std::cout<<"PASS durable multi-reply cursor, ordered receipts, restart ambiguity, bounded rejection, offline and pause tails\n";
}
void multiReplyDeliveryTests(const std::filesystem::path& scratch,bool prefix=false){
    FakeBot bot;bot.multiReplyMode=true;_putenv_s("HA_NAPCAT_TEST_API","fixture-api-token-not-real");_putenv_s("HA_NAPCAT_TEST_EVENT","fixture-event-secret-not-real");
    const int port=freePort();auto cfg=coreConfig(scratch);cfg.pluginRoot=HA_PLUGIN_ROOT;if(prefix)cfg.contextControl={{"reviewLayout","prefix"}};
    cfg.plugins={{"napcat",{{"enabled",true},{"selfUserId","10001"},{"ownerUserId","20001"},{"allowedGroups","30001"},{"apiOrigin","http://127.0.0.1:"+std::to_string(bot.port)},{"apiTokenEnvironment","HA_NAPCAT_TEST_API"},{"eventSecretEnvironment","HA_NAPCAT_TEST_EVENT"},{"callbackPort",port},{"cooldownSeconds",1},{"mergeWindowMs",0},{"maxReplyCharacters",4000}}}};
    Profile actor;actor.id="actor";actor.model.protocol=ayt::inference::Protocol::ChatCompletions;actor.model.origin="http://127.0.0.1:"+std::to_string(bot.port);actor.model.model="actor";actor.model.supportsStreaming=false;cfg.profiles.push_back(actor);auto reviewer=actor;reviewer.id="reviewer";reviewer.model.model="reviewer";cfg.profiles.push_back(reviewer);cfg.reviewEnabled=true;cfg.reviewProfileId="reviewer";
    auto app=std::make_unique<Application>(cfg);check(app->initialize(),"multireply host initialized");call(*app,"POST","/api/model",{{"id","actor"}});
    auto post=[&](const char* mid){httplib::Client client("127.0.0.1",port);const auto body=event("20001",mid,"MULTI_REPLY_FIXTURE","30001").dump();const auto response=client.Post("/onebot/events",{{"X-Signature",signature("fixture-event-secret-not-real",body)}},body,"application/json");check(response&&response->status==200,"multireply callback accepted");};
    auto transport=[&]{const auto plugins=call(*app,"GET","/api/capabilities").at("plugins");for(const auto& plugin:plugins)if(plugin.at("id")=="napcat")return plugin.at("current");throw std::runtime_error("napcat missing");};
    auto waitFor=[&](const std::function<bool()>& done){try{pump(*app,done);}catch(...){std::cerr<<"multireply synthetic timeout "<<Json{{"transport",transport()},{"sent",bot.size()},{"sends_started",bot.sendsStarted.load()},{"model_requests",bot.requestsStarted.load()},{"chat_status",call(*app,"GET","/api/chat/status")}}.dump()<<'\n';for(const auto& record:rows(scratch/"channels/napcat/10001/groups/30001/members/20001","ha.trace")){const auto trace=Json::parse(record.payload);Json diagnostic=Json::object();for(const auto* key:{"validation","provider_status","http_status","call_error","review_error","turns"})if(trace.contains(key))diagnostic[key]=trace.at(key);std::cerr<<"multireply synthetic trace "<<diagnostic.dump()<<'\n';}throw;}};
    auto settle=[&]{waitFor([&]{const auto now=transport();return !now.at("busy").get<bool>()&&now.at("transport").at("queued")==0;});};
    post("9201");waitFor([&]{return bot.size()==3;});settle();
    {std::lock_guard lock(bot.mutex);for(std::size_t i=0;i<3;++i){const auto& parts=bot.sent[i].at("message");check(parts.size()==(i==0?2:1),"group mention only accompanies first part");check(parts.back().at("data").at("text")==Json::array({"第一条。","第二条。","最后一条。"})[i],"model-defined short parts delivered in order");for(const auto& part:parts)check(part.at("type")!="image","text bundle never repeats media");}check(bot.actorCalls==1&&bot.reviewCalls==1,"multiple QQ parts use one actor result and one whole-bundle review");}
    post("9201");for(int i=0;i<8;++i){app->tick();std::this_thread::sleep_for(std::chrono::milliseconds(15));}check(bot.size()==3,"duplicate callback never repeats bundle");
    bot.sendFailAt=5;post("9202");waitFor([&]{return bot.sendsStarted>=5;});settle();check(bot.size()==4&&bot.sendsStarted==5,"ambiguous second part stops bundle without sending third");
    const auto base=scratch/"channels/napcat/10001/transport";bool partial=false;for(const auto& item:rows(base,"napcat")){const auto row=Json::parse(item.payload);if(row.value("message_id",std::string{})=="9202")partial=row.at("status")=="unknown"&&row.at("delivery_cursor")==1&&row.at("delivery_receipts").size()==1;}check(partial,"partial unknown stores exact successful prefix");
    app->stop();app=std::make_unique<Application>(cfg);check(app->initialize(),"multireply restart initialized");for(int i=0;i<10;++i){app->tick();std::this_thread::sleep_for(std::chrono::milliseconds(15));}check(bot.size()==4&&bot.sendsStarted==5,"restart does not replay successful or ambiguous parts");
    post("9203");waitFor([&]{return bot.size()==5;});call(*app,"POST","/api/control",{{"paused",true}});call(*app,"POST","/api/control",{{"paused",false}});settle();check(bot.size()==5,"manual pause retires remaining short messages");
    const std::string legacyLong(2401,'L');{std::lock_guard lock(bot.mutex);bot.multiReplyOutput={{"version",1},{"kind","reply"},{"text",legacyLong},{"calls",Json::array()}};}
    post("9204");waitFor([&]{return bot.size()==6;});settle();{std::lock_guard lock(bot.mutex);check(bot.sent.back().at("message").back().at("data").at("text")==legacyLong,"legacy reply above 2000 remains one complete QQ message");}
    {std::lock_guard lock(bot.mutex);bot.multiReplyOutput={{"version",1},{"kind","reply"},{"text",nullptr},{"messages",Json::array({"MUST_NOT_ESCAPE",std::string(2001,'X')})},{"calls",Json::array()}};}
    post("9205");waitFor([&]{return bot.size()==7;});settle();{std::lock_guard lock(bot.mutex);check(bot.sent.back().at("message").back().at("data").at("text").get<std::string>().starts_with("这次没能回上来"),"invalid bundle emits only application failure notice, no partial model text");for(const auto& sent:bot.sent)check(sent.dump().find("MUST_NOT_ESCAPE")==std::string::npos,"valid prefix of invalid bundle never escapes to QQ");}
    {std::lock_guard lock(bot.mutex);bot.multiReplyOutput={{"version",1},{"kind","reply"},{"text","第一小段。\n\n第二小段。\n\n第三小段。"},{"calls",Json::array()}};}
    post("9206");waitFor([&]{return bot.size()==10;});settle();{std::lock_guard lock(bot.mutex);for(std::size_t i=0;i<3;++i)check(bot.sent[7+i].at("message").back().at("data").at("text")==Json::array({"第一小段。","第二小段。","第三小段。"})[i],"legacy paragraph fallback reaches three real OneBot messages");}
    {std::lock_guard lock(bot.mutex);bot.multiReplyOutput={{"version",1},{"kind","reply"},{"text",nullptr},{"messages",Json::array({"保留这条。\n\n仍是同一条。","另一条。"})},{"calls",Json::array()}};}
    post("9207");waitFor([&]{return bot.size()==12;});settle();{std::lock_guard lock(bot.mutex);check(bot.sent[10].at("message").back().at("data").at("text")=="保留这条。\n\n仍是同一条。","authored boundaries override paragraph fallback");}
    app->stop();std::cout<<"PASS local QQ multireply order, one model call, group mention, callback dedup, unknown delivery, restart, pause, paragraph fallback, authored boundaries and atomic invalid-bundle rejection\n";
}
void multiReplyAdmissionTests(const std::filesystem::path& scratch){
    FakeBot bot;_putenv_s("HA_NAPCAT_TEST_API","fixture-api-token-not-real");_putenv_s("HA_NAPCAT_TEST_EVENT","fixture-event-secret-not-real");
    const auto s=settings({{"selfUserId","10001"},{"ownerUserId","20001"},{"allowedGroups","30001"}});
    const auto input=*parseEvent(event("20001","9301","ADMISSION_FIXTURE","30001"),s,nowMs());const std::string id=input.at("id");
    const auto transport=scratch/"channels/napcat/10001/transport";const Json parts=Json::array({"first","second","third"});
    {Ledger ledger(transport);ledger.enqueue(input,8);ledger.prepareReply(id,parts);}
    const Json plugin={{"enabled",true},{"selfUserId","10001"},{"ownerUserId","20001"},{"allowedGroups","30001"},{"apiOrigin","http://127.0.0.1:"+std::to_string(bot.port)},{"apiTokenEnvironment","HA_NAPCAT_TEST_API"},{"eventSecretEnvironment","HA_NAPCAT_TEST_EVENT"},{"callbackPort",freePort()},{"mergeWindowMs",0}};
    int admissions=0;
    {
        PluginRuntime runtime(HA_PLUGIN_ROOT,{scratch,std::filesystem::path(HA_PROJECT_ROOT),false,{}});std::string issue;check(runtime.configure({{"napcat",plugin}},issue),"prepared bundle transport initialized without model lease");runtime.event({{"kind","runtime.paused"},{"paused",false}});
        const auto end=nowMs()+12000;bool settled=false;while(nowMs()<end){
            for(const auto& e:runtime.takeEvents())if(e.value("kind",std::string{})=="napcat.delivery.check"){
                ++admissions;check(e.at("request_id")==id&&e.at("identity").at("group_id")=="30001","each part retains original request and route identity");
                runtime.event({{"kind","runtime.napcat.delivery"},{"token",e.at("token")},{"allowed",admissions==1},{"reason",admissions==1?"":"circadian_sleep"}});
            }
            const auto status=runtime.invoke("napcat.status",Json::object(),{}).at("result");if(admissions==2&&!status.at("busy").get<bool>()&&status.at("transport").at("queued")==0){settled=true;break;}
            runtime.tick(.01);std::this_thread::sleep_for(std::chrono::milliseconds(10));
        }
        check(settled&&admissions==2&&bot.size()==1&&bot.actorCalls==0,"fresh authorization before each part stops tail without model session");runtime.stop();
    }
    bool cancelledTail=false;for(const auto& item:rows(transport,"napcat")){const auto row=Json::parse(item.payload);if(row.value("id",std::string{})==id)cancelledTail=row.at("status")=="cancelled"&&row.at("delivery_cursor")==1&&row.at("delivery_receipts").size()==1&&row.at("delivery_stop_reason")=="circadian_sleep";}check(cancelledTail,"host denial persists exact confirmed prefix and stop reason");
    {PluginRuntime runtime(HA_PLUGIN_ROOT,{scratch,std::filesystem::path(HA_PROJECT_ROOT),false,{}});std::string issue;check(runtime.configure({{"napcat",plugin}},issue),"denied tail restart initialized");runtime.event({{"kind","runtime.paused"},{"paused",false}});for(int n=0;n<15;++n){runtime.tick(.01);std::this_thread::sleep_for(std::chrono::milliseconds(10));}check(bot.size()==1&&runtime.takeEvents().empty(),"restart never requests admission or replays denied tail");runtime.stop();}
    std::cout<<"PASS per-part host authorization, route identity, lease-free prepared delivery, sleep-denied tail and durable cancellation\n";
}
