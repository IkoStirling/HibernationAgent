void mediaLibraryProcessTests(const std::filesystem::path& scratch){
    FakeBot bot;bot.libraryMode=true;_putenv_s("HA_NAPCAT_TEST_API","fixture-api-token-not-real");_putenv_s("HA_NAPCAT_TEST_EVENT","fixture-event-secret-not-real");
    const auto assets=scratch/"assets";std::filesystem::create_directories(assets);const std::string gif="GIF89a"+std::string(40,'g');{std::ofstream f(assets/"sleep.gif",std::ios::binary);f<<gif;}{std::ofstream f(assets/"catalog.json",std::ios::binary);f<<Json{{"version",1},{"items",Json::array({{{"id","sleep"},{"file","sleep.gif"},{"name","困了"},{"meaning","想休息"},{"tags",Json::array({"困"})},{"sticker",true}}})}}.dump();}
    const auto port=freePort();const Json settings={{"enabled",true},{"selfUserId","10001"},{"ownerUserId","20001"},{"allowedGroups","30001"},{"apiOrigin","http://127.0.0.1:"+std::to_string(bot.port)},{"apiTokenEnvironment","HA_NAPCAT_TEST_API"},{"eventSecretEnvironment","HA_NAPCAT_TEST_EVENT"},{"callbackPort",port},{"cooldownSeconds",1},{"mergeWindowMs",0},{"mediaLibraryEnabled",true},{"mediaLibraryRoot",assets.generic_string()}};
    auto cfg=coreConfig(scratch);Profile actor;actor.id="actor";actor.model.protocol=ayt::inference::Protocol::ChatCompletions;actor.model.origin="http://127.0.0.1:"+std::to_string(bot.port);actor.model.model="actor";actor.model.supportsStreaming=false;
    const auto stage=Json::parse(readFile(cfg.characterRoot/"stages.json")).at("initial");PluginRuntime runtime(HA_PLUGIN_ROOT,{scratch,cfg.projectRoot,false,{}});std::string error;check(runtime.configure({{"napcat",settings}},error),"library transport configured");runtime.event({{"kind","runtime.paused"},{"paused",false}});
    auto post=[&](const std::string& id,const std::string& sender,const std::string& group){httplib::Client client("127.0.0.1",port);const auto body=event(sender,id,"困了，发张合适的表情。",group).dump();const auto response=client.Post("/onebot/events",{{"X-Signature",signature("fixture-event-secret-not-real",body)}},body,"application/json");check(response&&response->status==200,"library message accepted");};
    auto waitFor=[&](std::size_t count){const auto deadline=nowMs()+15000;while(nowMs()<deadline&&bot.size()<count){for(const auto& e:runtime.takeEvents()){const auto kind=e.value("kind",std::string{});const auto token=e.value("token",std::string{});
            if(kind=="napcat.context.request")runtime.event({{"kind","runtime.napcat.context"},{"token",token},{"available",true},{"config",{{"profiles",Json::array({channelProfile(cfg.profiles.front()),channelProfile(actor)})},{"selectedProfile","actor"},{"reviewEnabled",false},{"reviewProfileId","actor"},{"maxReviewRewrites",0},{"characterRoot",cfg.characterRoot.generic_string()},{"projectRoot",cfg.projectRoot.generic_string()},{"uiRoot",cfg.uiRoot.generic_string()},{"contextBytes",24000},{"maxToolRounds",6},{"maxStartsPerHour",600},{"state",{{"activity","idle"},{"energy",.7}}},{"stage",{{"id",stage},{"changed_at",0}}},{"desktopTools",Json::array()}}}});
            else if(kind=="napcat.delivery.check")runtime.event({{"kind","runtime.napcat.delivery"},{"token",token},{"allowed",true}});
            else if(kind=="napcat.budget.request")runtime.event({{"kind","runtime.napcat.budget"},{"token",token},{"allowed",true}});
            else check(kind!="napcat.tool.request","curated media requires no desktop screenshot or external tool");
        }runtime.tick(.01);std::this_thread::sleep_for(std::chrono::milliseconds(10));}check(bot.size()==count,"library image and final text delivered");};
    post("9401","20001","");waitFor(2);{std::lock_guard lock(bot.mutex);check(bot.sent[0].at("user_id")=="20001"&&bot.sent[0].at("message")[0].at("type")=="image","library asset stays on current private recipient");const auto data=bot.sent[0].at("message")[0].at("data");check(data.at("file")=="base64://"+mediaBase64(gif)&&data.at("sub_type")==1,"raw GIF is sent with sticker subtype");check(bot.actorCalls==3,"search, send and final response use three actor calls without vision analysis");check(bot.captured.dump().find(mediaBase64(gif))==std::string::npos,"pixels never enter any model request");}
    post("9402","20002","30001");waitFor(4);{std::lock_guard lock(bot.mutex);check(bot.sent[2].at("group_id")=="30001"&&bot.sent[2].at("message").back().at("type")=="image","group asset stays on bound group even without desktop control");check(bot.sent.size()==4,"duplicate image proposal in each batch is sent only once");}
    runtime.stop();_putenv_s("HA_NAPCAT_TEST_API","");_putenv_s("HA_NAPCAT_TEST_EVENT","");std::cout<<"PASS actual QQ library search/send, GIF bytes, private/group binding, duplicate suppression and no model pixels\n";
