{
  "id": "widget",
  "name": "桌面小角色",
  "description": "透明桌面小恐龙，支持拖动、点击、游走和对白气泡。",
  "version": "0.4.0",
  "api_version": 2,
  "library": "Hibernation_Widget.dll",
  "capabilities": [
    "desktop.overlay",
    "desktop.pointer-interaction",
    "animation.state-machine"
  ],
  "settings_ui": [
    {
      "key": "autonomousMode",
      "label": "自主控制：由角色批量选择空闲活动",
      "type": "toggle",
      "default": false
    },
    {
      "key": "autonomyIdleSeconds",
      "label": "交谈后空闲多久开始考虑活动（秒）",
      "type": "number",
      "default": 30,
      "min": 5,
      "max": 600,
      "step": 5
    }
  ],
  "settings_note": "自主模式采用有限命令队列，最多六项，执行时再寻找实际物件；新输入、拖动、暂停会清空旧计划。需要桌面小物或安静节律插件才能进食或休息。开启后替代插件原有的随机接近和自动休息。"
}
