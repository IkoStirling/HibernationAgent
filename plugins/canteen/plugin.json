{
  "id": "canteen",
  "name": "小食堂",
  "description": "共用BSimmer料理规则：可检索菜谱、真实库存、分阶段加工、背包、保鲜与程序虚拟补给。",
  "version": "0.3.0",
  "api_version": 2,
  "library": "Hibernation_Canteen.dll",
  "dependencies": [
    "habitat"
  ],
  "capabilities": [
    "canteen.cooking",
    "canteen.shelf",
    "inventory.backpack",
    "inventory.warehouse"
  ],
  "settings_ui": [
    {
      "key": "automatic",
      "type": "toggle",
      "label": "食堂自行少量备餐",
      "default": true
    },
    {
      "key": "automaticIntervalSeconds",
      "type": "number",
      "label": "自动备餐检查间隔（秒）",
      "default": 900,
      "min": 60,
      "max": 43200,
      "step": 60
    },
    {
      "key": "supplyIntervalSeconds",
      "type": "number",
      "label": "少量食材补给间隔（秒）",
      "default": 3600,
      "min": 300,
      "max": 86400,
      "step": 60
    },
    {
      "key": "shelfLifeSeconds",
      "type": "number",
      "label": "成品架保留时长（秒）",
      "default": 1800,
      "min": 60,
      "max": 43200,
      "step": 60
    },
    {
      "key": "allowSupplyOrders",
      "type": "toggle",
      "label": "允许申请少量程序虚拟食材",
      "default": true
    }
  ]
}
