    if(!state||state->plain.value.size()>1024*1024)fail("portable_mentor_invalid");MentorDocument index(state->plain.value);const auto& s=index.value;mentorKeys(s,{"format","session_id","records","created_ms","generation"});if(s.size()!=5||s.at("format")!="hibernation.mentor-session.v1"||!s.at("session_id").is_string()||!mentorId(s.at("session_id").get<std::string>()))fail("portable_mentor_invalid");mentorInteger(s.at("created_ms"));mentorInteger(s.at("generation"));if(!s.at("records").is_array()||s.at("records").size()>10000)fail("portable_mentor_invalid");std::set<std::string> expected;
    for(const auto& id:s.at("records")){if(!id.is_string()||!mentorId(id.get<std::string>())||!expected.insert(id.get<std::string>()).second||!paths.contains("mentors/default/records/"+id.get<std::string>()+".dpapi"))fail("portable_mentor_invalid");}
