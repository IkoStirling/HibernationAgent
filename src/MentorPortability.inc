struct MentorAttachment{std::string path,digest;Secret plain;};
struct PortableMaterial{std::vector<Master> stores;std::vector<MentorAttachment> mentor;};
bool mentorId(const std::string& id){return id.size()==32&&id.find_first_not_of("0123456789abcdef")==std::string::npos;}
bool mentorPath(const std::string& path){constexpr std::string_view root="mentors/default/records/";return path=="mentors/default/state.dpapi"||(path.starts_with(root)&&path.ends_with(".dpapi")&&mentorId(path.substr(root.size(),path.size()-root.size()-6)));}
