}catch(const nlohmann::json::exception&){fail("portable_mentor_invalid");}
Secret unprotectMentor(const fs::path& path){
    auto bytes=read(path,1024*1024+65536);DATA_BLOB input{static_cast<DWORD>(bytes.size()),reinterpret_cast<BYTE*>(bytes.data())},output{};if(!CryptUnprotectData(&input,nullptr,nullptr,nullptr,nullptr,CRYPTPROTECT_UI_FORBIDDEN,&output))fail("portable_mentor_locked");Secret result;try{if(output.cbData>1024*1024)fail("portable_mentor_limit");result.value.assign(reinterpret_cast<const char*>(output.pbData),output.cbData);}catch(...){SecureZeroMemory(output.pbData,output.cbData);LocalFree(output.pbData);throw;}SecureZeroMemory(output.pbData,output.cbData);LocalFree(output.pbData);return result;
