        if(kind=="user")mentorKeys(d,{"goal","context","obstacle","attempts","execute","available_tools"});else if(kind=="assistant")mentorKeys(d,{"summary","status","operations_executed","receipts","provider_thread_id"});else if(kind=="note")mentorKeys(d,{"text","sources","category"});else if(kind=="operation")mentorKeys(d,{"item_type","status","turn_id","item_id","exit_code"});else if(kind=="interruption")mentorKeys(d,{"reason","turn_id","pending_method"});else fail("portable_mentor_invalid");noMentorCredentials(d);
