void mentorInteger(const Json& value){if(!value.is_number_integer()||value.get<double>()<0||value.get<double>()>static_cast<double>(INT64_MAX))fail("portable_mentor_invalid");}
void noMentorCredentials(const Json& value,unsigned depth=0){
    if(depth>32)fail("portable_mentor_invalid");if(value.is_object())for(auto it=value.begin();it!=value.end();++it){const auto key=lower(it.key());static const std::set<std::string> forbidden={"auth","authorization","credentials","access_token","refresh_token","id_token","api_key","apikey","tokens","password","secret"};if(forbidden.contains(key))fail("portable_mentor_credentials");noMentorCredentials(it.value(),depth+1);}else if(value.is_array())for(const auto& row:value)noMentorCredentials(row,depth+1);
}
void wipeMentorJson(Json& value)noexcept{try{if(value.is_string()){auto& s=value.get_ref<std::string&>();ayt::crypto::secureZero(s.data(),s.size());}else if(value.is_structured())for(auto& row:value)wipeMentorJson(row);value.clear();}catch(...) {}}
