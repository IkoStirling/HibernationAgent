        for(auto it=rows.records.rbegin();it!=rows.records.rend();++it){const auto& row=*it;if(std::find(recent.end()-std::min<std::size_t>(recent.size(),4),recent.end(),row.id)!=recent.end())continue;const auto raw=Json::parse(row.payload);if(isLegacyMetaReply(raw))continue;const auto value=libraryArchiveView(raw);if(value.is_null())continue;const auto text=value.value("text",std::string{});if(text.size()<static_cast<std::size_t>(minimum))continue;if(text.size()>256*1024){++oversize;continue;}bool known=false;for(const auto& memory:memories){const auto m=Json::parse(memory.payload);if(!policy.memories.contains(memory.id)&&policy.allows(m)&&m.value("compacted_from",Json::object())==Json{{"scope",archiveScope},{"id",row.id},{"revision",row.revision}}){known=true;break;}}if(known)continue;++eligible;if(sources.size()<static_cast<std::size_t>(limit)){sources.push_back({{"id",row.id},{"revision",row.revision},{"kind",raw.at("kind")},{"scope",archiveScope}});bytes+=text.size();}}
        Json out={{"eligible",eligible},{"selected",sources.size()},{"original_bytes",bytes},{"oversize_deferred",oversize},{"recent_messages_retained",true}};if(details)out["sources"]=sources;return out;
    }
    bool workshopStorageAllowed(const Config& candidate)const{
        if(!workshop::validateRoots(candidate))return false;
        // Previously used backup parents remain protected after changing paths.
        for(const auto& root:get("ha.workshop","backup_roots",Json::array()).value){auto old=candidate;old.memoryWorkshop["backupRoot"]=root;if(!workshop::validateRoots(old))return false;}return true;
    }
    LocalReply workshopRequest(const LocalRequest& req,const Json& body){
