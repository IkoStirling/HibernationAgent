        for(const auto& key:get("ha.workshop","queue",Json::array()).value){auto row=get("ha.workshop-jobs",key);if(!row.revision||row.value.at("status")!="queued")continue;auto value=row.value;const bool backup=value.at("type")=="backup";
            const auto manager=profile(cfg.reviewEnabled?cfg.reviewProfileId:get("ha.settings","model").value.at("id").get<std::string>());const bool allowed=runtimePaused&&(backup?runtimeOffline.load():(!runtimeOffline.load()||manager.model.protocol==ayt::inference::Protocol::Mock));
            if(!allowed){const auto reason=backup?"pause_and_offline_required":"pause_required_and_model_must_be_online";if(value.value("waiting_reason",std::string{})!=reason){value["waiting_reason"]=reason;saveWorkshop(row,value);}continue;}
            if(activityGenerator.running()||reactionGenerator.running())continue;
