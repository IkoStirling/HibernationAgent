            auto queueState=get("ha.workshop","queue",Json::array());if(queueState.value.size()>=128)return error(409,"workshop_queue_full");
            Json value={{"id",key},{"type",type},{"status",type=="lora"?"awaiting_backend":"queued"},{"created_ms",serviceNowMs()},{"completed_steps",0},{"total_steps",0},{"request",body},{"checkpoints",Json::array()}};
            if(type=="distill"){try{const auto preview=workshopCandidates(body,true);value["sources"]=preview.at("sources");value["total_steps"]=preview.at("selected");value["original_bytes"]=preview.at("original_bytes");value["oversize_deferred"]=preview.at("oversize_deferred");if(preview.at("selected")==0)return error(409,"workshop_no_candidates");}catch(...){return error(400,"workshop_scan_or_options");}}
            if(type=="lora"){
                const auto plan=body.value("plan",Json::object());if(!plan.is_object()||plan.dump().size()>8192)return error(400,"workshop_training_plan");for(auto it=plan.begin();it!=plan.end();++it)if(it.key()!="baseModel"&&it.key()!="adapterPath"&&it.key()!="checkpointPath"&&it.key()!="steps"&&it.key()!="saveEvery")return error(400,"workshop_training_plan");
                for(const auto* field:{"baseModel","adapterPath","checkpointPath"}){const auto text=plan.value(field,std::string{});if(text.size()>2048||text.find_first_of("\r\n")!=std::string::npos||text.find('\0')!=std::string::npos)return error(400,"workshop_training_plan");}for(const auto* field:{"steps","saveEvery"})if(!plan.contains(field)||!plan.at(field).is_number_integer()||plan.at(field).get<std::int64_t>()<1||plan.at(field).get<std::int64_t>()>1000000)return error(400,"workshop_training_plan");if(plan.at("saveEvery")>plan.at("steps"))return error(400,"workshop_training_plan");value["plan"]=plan;value["backend_status"]="not_connected";value["weights_written"]=false;
            }
            std::vector<RecordMutation> changes;
            if(type=="backup"){if(!workshopStorageAllowed(cfg))return error(400,"workshop_backup_root");auto roots=get("ha.workshop","backup_roots",Json::array());const auto root=utf8(workshop::backupRoot(cfg));value["backup_parent"]=root;if(std::find(roots.value.begin(),roots.value.end(),root)==roots.value.end()){if(roots.value.size()>=128)return error(409,"workshop_backup_roots_limit");roots.value.push_back(root);changes.push_back(mutation("ha.workshop","backup_roots",roots,roots.value));}}
            queueState.value.insert(queueState.value.begin(),key);changes.push_back(mutation("ha.workshop","queue",queueState,queueState.value));changes.push_back(mutation("ha.workshop-jobs",key,prior,value));commit(std::move(changes),"memory-workshop-create");return reply(202,{{"id",key},{"status",value.at("status")}});
