                const auto& ref=value.at("sources").at(value.at("completed_steps").get<std::size_t>());ProposalContext context;context.eventKind="operator_memory_distillation";context.sources[ref.at("id")]=Source{ref.at("id"),ref.at("revision"),ref.at("kind"),archiveScope};const auto result=compactMemory(ref.at("id"),context,value.at("id"),[cancel]{return cancel->load();});if(!result.value("ok",false))return {{"ok",false},{"issue",result.value("error",Json::object()).value("code",std::string("workshop_distillation_failed"))}};return {{"ok",true},{"result",result.at("result")}};
