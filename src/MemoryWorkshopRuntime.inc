    void initializeWorkshop(){if(cfg.channel)return;for(const auto& key:get("ha.workshop","queue",Json::array()).value){auto row=get("ha.workshop-jobs",key);auto value=row.value;if(row.revision&&(value.at("status")=="running"||value.at("status")=="queued"||value.at("status")=="pausing"||value.at("status")=="cancelling"||(value.at("type")=="backup"&&value.at("status")=="paused"))){value["status"]=value.at("type")=="backup"?"failed":"paused";value["issue"]=value.at("type")=="backup"?"workshop_backup_restart":"recovered_checkpoint";saveWorkshop(row,value);}}}
    void stopWorkshop(){if(!workshopFuture.valid())return;auto row=get("ha.workshop-jobs",workshopActive);auto value=row.value;value["status"]=value.at("type")=="backup"?"cancelling":"pausing";saveWorkshop(row,value);if(workshopCancel)workshopCancel->store(true);try{workshopFuture.wait();}catch(...){}harvestWorkshop();}
    void harvestWorkshop(){
        if(!workshopFuture.valid()||workshopFuture.wait_for(std::chrono::seconds(0))!=std::future_status::ready)return;Json result;try{result=workshopFuture.get();}catch(...){result={{"ok",false},{"issue","workshop_step_failed"}};}auto row=get("ha.workshop-jobs",workshopActive);auto value=row.value;workshopActive.clear();workshopCancel.reset();
        const auto status=value.at("status").get<std::string>();if(result.value("ok",false)){
            if(result.contains("prepared")){value["backup_plan"]=result.at("prepared");value["receipts"]=Json::array();value["total_steps"]=value.at("backup_plan").at("files").size()+1;value["process_started"]=resumedAtMs;value["path"]=value.at("backup_plan").at("root");}
            else{value["completed_steps"]=value.at("completed_steps").get<int>()+1;if(value.at("type")=="backup"&&result.contains("receipt"))value["receipts"].push_back(result.at("receipt"));if(result.contains("result")){value["last_result"]=result.at("result");if(value.at("type")=="distill"){value["derived_records"]=value.value("derived_records",0)+1;value["saved_chunks"]=value.value("saved_chunks",0)+result.at("result").value("chunks",0);value["summary_bytes"]=value.value("summary_bytes",std::size_t(0))+result.at("result").value("summary_bytes",std::size_t(0));}}value["checkpoints"].push_back({{"step",value.at("completed_steps")},{"saved_ms",serviceNowMs()}});}
        }
        if(status=="pausing"||status=="cancelling")value["status"]=status=="pausing"?"paused":"cancelled";
        else if(!result.value("ok",false)){value["status"]="failed";value["issue"]=result.value("issue",std::string("workshop_step_failed"));}
        else value["status"]=value.at("completed_steps")==value.at("total_steps")&&value.at("total_steps").get<int>()>0?"completed":"queued";
        if(value.at("status")=="completed")value["finished_ms"]=serviceNowMs();saveWorkshop(row,value);
    }
